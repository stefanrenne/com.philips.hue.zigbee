  "rules": [
    {
      "name": "Pre-2019 hardware (not supported)",
      "pattern": "^(LCT00|LCT01|LLC|LST00|LWB|LWW|LTW01)",
      "imageTypes": []
    },
    {
      "name": "Motion sensors (2022+)",
      "pattern": "^SML",
      "imageTypes": [
        "0x011B"
      ]
    },
    {
      "name": "Contact sensors",
      "pattern": "^SOC",
      "imageTypes": [
        "0x0125"
      ]
    },
    {
      "name": "Smart plugs",
      "pattern": "^LOM",
      "imageTypes": [
        "0x011A"
      ]
    },
    {
      "name": "Ensis / Flourish (ModuLumV3)",
      "pattern": "^4090",
      "imageTypes": [
        "0x011F"
      ]
    },
    {
      "name": "Hue Go (PortableV3)",
      "pattern": "^(LCT026|929003128501)$",
      "imageTypes": [
        "0x0120"
      ]
    },
    {
      "name": "Gradient / pixel products (PixelLum)",
      "pattern": "^(LCX|LGT|915005987101)",
      "imageTypes": [
        "0x0118"
      ]
    },
    {
      "name": "Zigbee luminaires (ModuLumV2, EFR32MG13)",
      "pattern": "^(LTC|LTP|LCF|LCS|LCT024)",
      "imageTypes": [
        "0x011D"
      ]
    },
    {
      "name": "Bulbs, GU10 spots and bulb-based fixtures (Bluetooth, EFR32MG21)",
      "pattern": "^(LCA|LTA|LWA|LCE|LTE|LWE|LCG|LTG|LWG|LCO|LTO|LWO|LCV|LTV|LWV|LWU|LCU|LTD|LTW|LCD|LCY|LCZ|504|506[23]|5309|5633|3418131|929003074701)",
      "imageTypes": [
        "0x0114"
      ]
    },
    {
      "name": "Luminaires and lightstrips (Bluetooth ModuLum, EFR32MG21)",
      "pattern": "^([13][0-9]{6}P|44[0-9]{5}P|5060|915|929|LCL|LCW|HBL|HML)",
      "imageTypes": [
        "0x0117"
      ]
    },
    {
      "name": "Fallback for any other light",
      "template": "^light_",
      "imageTypes": [
        "0x0114"
      ]
    }
  ]
}
